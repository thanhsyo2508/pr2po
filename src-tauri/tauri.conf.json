{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PR2PO",
  "version": "0.1.3",
  "identifier": "vn.meiko.pr2po",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PR2PO — Xử lý yêu cầu mua hàng",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJFNkUzQTBEQTRBRERBRTUKUldUbDJxMmtEVHB1TG95bTRMRVNlMWJqTHNvcGxtUGhHRkVhSFVUQWR2cGp6QnFVbmN0Y1dBVGEK",
      "endpoints": [
        "https://clm.tmgtech.io.vn/po2pr/api/v1/manifest/{{target}}/{{arch}}/{{bundle_type}}/latest"
      ]
    }
  }
}
