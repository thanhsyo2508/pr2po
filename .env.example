# Default updater URL for first launch. Users can change it later in the Update dialog.
VITE_UPDATE_BASE_URL=https://clm.tmgtech.io.vn/po2pr

# SSH is only used by the release upload script. Keep real values in local .env.
SSH_SERVER_HOST=
SSH_SERVER_PORT=22
SSH_SERVER_USER=
SSH_SERVER_PASSWORD=
SSH_SERVER_HOST_KEY_SHA256=

# Absolute path to the Tauri updater signing key. Never commit or upload the private key.
TAURI_SIGNING_PRIVATE_KEY=C:\Users\<user>\.tauri\pr2po-updater.key
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# Update service settings (configure on the server, not in the desktop app).
PR2PO_UPDATE_BIND=127.0.0.1
PR2PO_UPDATE_PORT=8787
PR2PO_UPDATE_STORAGE=/var/lib/pr2po-updates
PR2PO_UPDATE_PUBLIC_URL=https://clm.tmgtech.io.vn/po2pr
PR2PO_REQUIRE_HTTPS=true
PR2PO_UPDATE_MAX_UPLOAD_MB=512
PR2PO_ADMIN_USER=release-admin
# Generate with: python server/set_admin_password.py. Store this hash on the server only.
PR2PO_ADMIN_PASSWORD_HASH=
PR2PO_ADMIN_SESSION_TTL=7200

# Local publisher destination on the server; required by server/deploy_release.py.
PR2PO_UPDATE_REMOTE_DIR=/var/lib/pr2po-updates
